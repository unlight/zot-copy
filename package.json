{
  "name": "zot-copy",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "zot /copy — copy the last agent response to the system clipboard",
  "keywords": [
    "zot",
    "zot-extension",
    "clipboard",
    "slash-command"
  ],
  "homepage": "https://github.com/unlight/zot-copy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unlight/zot-copy.git"
  },
  "bugs": {
    "url": "https://github.com/unlight/zot-copy/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown && chmod +x dist/copy.js",
    "test": "npm run build && node --test src/copy.test.ts",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint 'src/**/*.ts'",
    "eslint:fix": "npm run eslint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run eslint && npm run typecheck"
  },
  "dependencies": {
    "marked": "15.0.12",
    "marked-jira": "1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "changelog-sentence-case": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
